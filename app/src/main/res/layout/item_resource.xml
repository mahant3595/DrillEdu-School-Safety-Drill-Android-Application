<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/card_bg"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <ImageView
            android:id="@+id/iv_resource_icon"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="Resource Icon"
            android:src="@drawable/ic_resources" />

        <ImageView
            android:id="@+id/btn_bookmark"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_alignParentEnd="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Bookmark"
            android:padding="4dp"
            android:src="@drawable/ic_bookmark" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:layout_marginStart="14dp"
            android:layout_toEndOf="@id/iv_resource_icon"
            android:layout_toStartOf="@id/btn_bookmark"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_resource_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="School Fire Safety Guide for Students"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_resource_meta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Articles • 3 min read"
                android:textColor="@color/safety_yellow"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tv_resource_summary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:text="Essential rules on fire prevention, smoke safety, and exit maneuvers."
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

    </RelativeLayout>
</com.google.android.material.card.MaterialCardView>