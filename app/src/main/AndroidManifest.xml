<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.DrillEdu">

        <!-- Splash Activity (Launcher) -->
        <activity
            android:name=".activities.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.DrillEdu">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Main Shell Host Activity -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:theme="@style/Theme.DrillEdu"
            android:windowSoftInputMode="adjustResize" />

        <!-- Feature Module Activities -->
        <activity
            android:name=".activities.GuidelinesActivity"
            android:exported="false"
            android:theme="@style/Theme.DrillEdu" />

        <activity
            android:name=".activities.SafetyDetailActivity"
            android:exported="false"
            android:theme="@style/Theme.DrillEdu" />

        <activity
            android:name=".activities.DrillDetailActivity"
            android:exported="false"
            android:theme="@style/Theme.DrillEdu" />

        <activity
            android:name=".activities.ChecklistActivity"
            android:exported="false"
            android:theme="@style/Theme.DrillEdu" />

        <activity
            android:name=".activities.ResourceDetailActivity"
            android:exported="false"
            android:theme="@style/Theme.DrillEdu" />

        <activity
            android:name=".activities.EmergencyContactsActivity"
            android:exported="false"
            android:theme="@style/Theme.DrillEdu" />

        <activity
            android:name=".activities.QuizActivity"
            android:exported="false"
            android:theme="@style/Theme.DrillEdu" />

        <activity
            android:name=".activities.QuizResultActivity"
            android:exported="false"
            android:theme="@style/Theme.DrillEdu" />

        <activity
            android:name=".activities.ProgressActivity"
            android:exported="false"
            android:theme="@style/Theme.DrillEdu" />

        <activity
            android:name=".activities.SettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.DrillEdu" />

    </application>

</manifest>